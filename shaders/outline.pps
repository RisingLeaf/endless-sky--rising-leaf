u_in vec2 scale;
u_in vec2 position;
u_in mat2 transform;

u_in float frame;
u_in float frameCount;
u_in vec4  color;
u_in vec2  off;


v_in vec2 vert;
v_in vec2 vertTexCoord;

v_out vec2 fragTexCoord;

VS_BEGIN
	fragTexCoord = vertTexCoord;
	gl_Position = vec4((spec.transform * vert + spec.position) * spec.scale, 0, 1);
VS_END

in_texture 2darray tex;

float Sobel(USE_UBO const float layer, const vec2 tex_coord)
{
    const vec4 weight = vec4(0.4, 0.4, 0.4, 1.0);
	float sum = 0.0;
	for(int dy = -1; dy <= 1; ++dy)
	{
		for(int dx = -1; dx <= 1; ++dx)
		{
			const vec2 center = tex_coord + 0.618034 * spec.off * vec2(dx, dy);

			const float nw = dot(texture(tex, vec3(center + vec2(-spec.off.x, -spec.off.y), layer)), weight);
			const float ne = dot(texture(tex, vec3(center + vec2( spec.off.x, -spec.off.y), layer)), weight);
			const float sw = dot(texture(tex, vec3(center + vec2(-spec.off.x,  spec.off.y), layer)), weight);
			const float se = dot(texture(tex, vec3(center + vec2( spec.off.x,  spec.off.y), layer)), weight);

			const float h = nw + sw - ne - se + 2.0 * (
				  dot(texture(tex, vec3(center + vec2(-spec.off.x, 0.0), layer)), weight)
				- dot(texture(tex, vec3(center + vec2( spec.off.x, 0.0), layer)), weight));
			const float v = nw + ne - sw - se + 2.0 * (
				  dot(texture(tex, vec3(center + vec2(0.0, -spec.off.y), layer)), weight)
				- dot(texture(tex, vec3(center + vec2(0.0,  spec.off.y), layer)), weight));
			sum += h * h + v * v;
		}
	}
	return sum;
}

FS_BEGIN
	const float first  = floor(spec.frame);
	const float second = mod(ceil(spec.frame), spec.frameCount);
	const float fade   = spec.frame - first;
	const float sum    = mix(Sobel(PASS_UBO first, fragTexCoord), Sobel(PASS_UBO second, fragTexCoord), fade);
	out_color = spec.color * sqrt(sum / 180.0);
FS_END
