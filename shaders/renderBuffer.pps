u_in vec2 size;
u_in vec2 position;
u_in vec2 scale;
u_in vec2 srcposition;
u_in vec2 srcscale;
u_in vec4 fade;


v_in vec2 vert;

v_out vec2 tpos;
v_out vec2 vpos;

VS_BEGIN
	gl_Position = vec4((spec.position + vert * spec.size) * spec.scale, 0, 1);

	vpos = vert + vec2(0.5);
	const vec2 tsize = spec.size * spec.srcscale;
	const vec2 tsrc  = spec.srcposition * spec.srcscale;

	tpos = vpos * tsize + tsrc;
	//tpos.x = 1.0 - tpos.x;
	tpos.y = tpos.y;
VS_END

in_texture 2d tex;

FS_BEGIN
	const float epsilon      = 0.001;
	const float weightTop    = clamp((        vpos.y + epsilon) / (spec.fade.x + epsilon), 0.0, 1.0);
	const float weightBottom = clamp(((1.0 - vpos.y) + epsilon) / (spec.fade.y + epsilon), 0.0, 1.0);
	const float weightLeft   = clamp((        vpos.x + epsilon) / (spec.fade.z + epsilon), 0.0, 1.0);
	const float weightRight  = clamp(((1.0 - vpos.x) + epsilon) / (spec.fade.w + epsilon), 0.0, 1.0);
	const float weight       = min(min(min(weightTop, weightBottom), weightLeft), weightRight);
	if(tpos.x > 0.0 && tpos.y > 0.0 && tpos.x < 1.0 && tpos.y < 1.0)
	{
		out_color = texture(tex, tpos) * weight;
	}
	else
	{
		discard;
    }
FS_END
