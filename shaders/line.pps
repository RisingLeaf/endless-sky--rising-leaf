u_in vec2  scale;
u_in vec2  start;
u_in vec2  end;
u_in float width;
u_in int   cap;

u_in vec4 startColor;
u_in vec4 endColor;


v_in vec2 vert;

v_out vec2 pos;
v_out vec4 color;

VS_BEGIN
	const vec2 unit = normalize(spec.end - spec.start);
	const vec2 origin = vert.y > 0.0 ? spec.start : spec.end;

	color = vert.y > 0.0 ? spec.startColor : spec.endColor;

	const float widthOffset = spec.width + 1.;
	const float capOffset   = spec.cap == 1 ? widthOffset : 1.;
	pos = origin + vec2(unit.y, -unit.x) * vert.x * widthOffset - unit * capOffset * vert.y;

	gl_Position = vec4(pos / spec.scale, 0, 1);
	gl_Position.y = -gl_Position.y;
	gl_Position.xy *= 2.0;
VS_END

// From https://iquilezles.org/articles/distfunctions2d/ - functions to get the distance from a point to a shape.
float sdSegment(const vec2 p, const vec2 a, const vec2 b)
{
	const vec2  ab = b - a;
	const vec2  ap = p - a;
	const float h  = clamp(dot(ap, ab) / dot(ab, ab), 0.0, 1.0);
	return length(ap - h * ab);
}

float sdOrientedBox(const vec2 p, const vec2 a, const vec2 b, const float th)
{
	const float l = length(b - a);
	const vec2  d = (b - a) / l;

	vec2 q = (p - (a + b) * 0.5);
	q = mat2(d.x, -d.y, d.y, d.x) * q;
	q = abs(q) - vec2(l, th) * 0.5;

	return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0);
}

FS_BEGIN
	const float dist = spec.cap == 1
	                   ? spec.width - sdSegment(pos, spec.start, spec.end)
	                   : 1. - sdOrientedBox(pos, spec.start, spec.end, spec.width);
	const float alpha = clamp(dist, 0.0, 1.0);
	out_color = color * alpha;
FS_END
